# CI и интеграционные тесты принудительно выставляют STUB_FAIL_RATE=0, STUB_TIMEOUT_RATE=0,
# STUB_SLOW_RATE=0 для обоих стендов поставщиков — сценарии таймаутов/фолбэка проверяются
# явными вызовами /_control/scenario, а не случайностью.

########################################
# apps/api
########################################

NODE_ENV=development
# окружение: development|test|production
PORT=3000
# HTTP-порт API
DATABASE_URL=postgres://postgres:postgres@localhost:5432/store
# строка подключения к PostgreSQL, обязательна
DB_POOL_SIZE=20
# максимальный размер пула соединений TypeORM
DB_STATEMENT_TIMEOUT_MS=10000
# statement_timeout сессии — зависший запрос не держит блокировку вечно
DB_LOCK_TIMEOUT_MS=5000
# lock_timeout сессии — ограничивает ожидание FOR UPDATE при гонке
DB_TX_RETRY_ATTEMPTS=3
# число повторов транзакции при SQLSTATE 40001/40P01
LOG_LEVEL=info
# минимальный уровень логирования: debug|info|warn|error
LOG_FORMAT=json
# формат вывода логов: json|pretty
LOG_STACK=false
# включать ли стек ошибок в лог-записи

SUPPLIER_A_BASE_URL=http://localhost:4001
# базовый URL заглушки поставщика A
SUPPLIER_B_BASE_URL=http://localhost:4002
# базовый URL заглушки поставщика B
SUPPLIER_REQUEST_TIMEOUT_MS=2000
# таймаут одного HTTP-вызова к поставщику (AbortSignal.timeout)
SUPPLIER_MAX_ATTEMPTS_PER_SUPPLIER=2
# число повторов при однозначном отказе одного поставщика
SUPPLIER_UNKNOWN_MAX_RESOLVE_ATTEMPTS=5
# число попыток разрешить неизвестный исход перед abandoned_unknown
SUPPLIER_RETRY_BASE_MS=200
# база backoff между повторными вызовами поставщика
SUPPLIER_RETRY_MAX_MS=2000
# потолок backoff между повторными вызовами поставщика
SUPPLIER_JOB_BUDGET_MS=10000
# бюджет времени на всю задачу доставки одного заказа
SUPPLIER_VIRTUAL_STOCK=1000
# посеянный available_count для SKU в режиме supplier

WORKER_ENABLED=true
# запускать ли цикл фоновых задач в этом процессе
WORKER_ID=
# идентификатор воркера в jobs.locked_by; по умолчанию hostname:pid
JOB_POLL_INTERVAL_MS=200
# период цикла выборки задач
JOB_BATCH_SIZE=5
# число задач, забираемых за один проход
JOB_MAX_ATTEMPTS=8
# число попыток перед переводом задачи в dead
JOB_RETRY_BASE_MS=500
# база backoff между попытками задачи
JOB_RETRY_MAX_MS=30000
# потолок backoff между попытками задачи
JOB_LOCK_TTL_MS=120000
# возраст блокировки задачи, после которого она считается зависшей

SWEEPER_ENABLED=true
# запускать ли обходчик "зависших" заказов в этом процессе
SWEEPER_INTERVAL_MS=15000
# период запуска обходчика
SWEEPER_BATCH_SIZE=100
# число строк за один проход обходчика
STUCK_ORDER_AGE_SECONDS=60
# возраст заказа paid без доставки, после которого он считается зависшим
DELIVERY_FAILED_RETRY_SECONDS=300
# возраст delivery_failed, после которого выполняется повтор
MAX_DELIVERY_GENERATIONS=5
# предел числа поколений автоматических повторов доставки
ATTEMPT_INFLIGHT_TIMEOUT_MS=30000
# возраст попытки in_flight, после которого она переводится в unknown
ORPHAN_TTL_SECONDS=3600
# возраст orphan-события, после которого оно считается abandoned
STOCK_RECONCILE_INTERVAL_MS=60000
# период фоновой сверки счётчиков остатков

ADMIN_API_ENABLED=true
# включать ли /admin/* эндпоинты
ADMIN_TOKEN=dev-admin-token
# значение заголовка x-admin-token; пустое значение отключает проверку

CATALOG_DEFAULT_LIMIT=24
# размер страницы каталога по умолчанию
CATALOG_MAX_LIMIT=100
# максимально допустимый размер страницы каталога

########################################
# apps/supplier-stub (инстанс A: PORT=4001, SUPPLIER_ID=A)
########################################

SUPPLIER_ID=A
# идентификатор стенда: A|B — влияет на префикс кодов и лог-строки
PORT=4001
# HTTP-порт стенда (для B — 4002)
STUB_INVENTORY_SIZE=100
# количество кодов, которые может выдать этот инстанс
STUB_FAIL_RATE=0.2
# вероятность 5xx в режиме normal (для A — 0.2, для B — 0.1); CI/интеграционные тесты ставят 0
STUB_TIMEOUT_RATE=0.2
# вероятность зависания в режиме normal (для A — 0.2, для B — 0.05); CI/интеграционные тесты ставят 0
STUB_SLOW_RATE=0.3
# вероятность медленного, но успешного ответа в режиме normal (для A — 0.3, для B — 0.2); CI/интеграционные тесты ставят 0
STUB_LATENCY_MS_MIN=500
# нижняя граница задержки медленного ответа (должна быть меньше клиентского таймаута)
STUB_LATENCY_MS_MAX=1500
# верхняя граница задержки медленного ответа
STUB_HANG_MS=6000
# длительность зависания (должна превышать клиентский таймаут)
STUB_PERSIST_PATH=./.stub-state-A.json
# путь файла персистентности request_id -> code; пустое значение отключает персистентность
STUB_CONTROL_ENABLED=true
# включать ли /_control/* эндпоинты управления стендом
LOG_LEVEL=info
# минимальный уровень логирования, как в apps/api
LOG_FORMAT=json
# формат вывода логов, как в apps/api

########################################
# tools
########################################

API_BASE_URL=http://localhost:3000
# базовый URL API для CLI-скриптов tools/*
SUPPLIER_A_BASE_URL=http://localhost:4001
# базовый URL стенда A для CLI-скриптов tools/*
SUPPLIER_B_BASE_URL=http://localhost:4002
# базовый URL стенда B для CLI-скриптов tools/*
ADMIN_TOKEN=dev-admin-token
# токен администратора для CLI-скриптов, вызывающих /admin/*
DATABASE_URL=postgres://postgres:postgres@localhost:5432/store
# строка подключения к PostgreSQL для seed-скриптов
